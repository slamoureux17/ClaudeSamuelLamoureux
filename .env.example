# Copiez ce fichier en .env et complétez les valeurs.

# Base de données de l'application (SQLite par défaut; PostgreSQL / SQL Server possibles)
DATABASE_URL=sqlite:///scorecard.db
# SCORECARD_YEAR=2026        # par défaut: l'année en cours

# --- Pipedrive ---
# Jeton personnel: Pipedrive > Paramètres personnels > API
PIPEDRIVE_API_TOKEN=
# Sous-domaine de votre compte (https://<domaine>.pipedrive.com)
PIPEDRIVE_DOMAIN=
# Clés (hash de 40 caractères) des champs personnalisés d'organisation à alimenter (optionnel)
# Pipedrive > Paramètres de l'entreprise > Champs de données > Organisation
PIPEDRIVE_FIELD_SERTI=
PIPEDRIVE_FIELD_POTENTIEL=
PIPEDRIVE_FIELD_PENETRATION=
PIPEDRIVE_FIELD_TOPGRADING=
PIPEDRIVE_FIELD_SATISFACTION=

# --- Base de données source (votre BD interne ou une réplique Serti) ---
# Exemples:
#   SQL Server: mssql+pyodbc://usager:motdepasse@serveur/base?driver=ODBC+Driver+18+for+SQL+Server
#   PostgreSQL: postgresql+psycopg://usager:motdepasse@serveur/base
#   ODBC (DSN): mssql+pyodbc://@MonDSN
SOURCE_DB_URL=
SOURCE_QUERY_FILE=requete_ventes.sql
